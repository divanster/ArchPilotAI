# Copy to .env and set a local-only password. Never commit .env.
ARCHPILOT_ENVIRONMENT=local
ARCHPILOT_LOG_LEVEL=INFO
ARCHPILOT_DB_HOST=localhost
ARCHPILOT_DB_PORT=5432
ARCHPILOT_DB_NAME=archpilot
ARCHPILOT_DB_USER=archpilot
ARCHPILOT_DB_PASSWORD=
# Max upload size in bytes (default 1 MiB)
ARCHPILOT_MAX_UPLOAD_BYTES=1048576
