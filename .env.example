# Copy to .env and set a local-only password. Never commit .env.
ARCHPILOT_ENVIRONMENT=local
ARCHPILOT_LOG_LEVEL=INFO
ARCHPILOT_DB_HOST=localhost
ARCHPILOT_DB_PORT=5432
ARCHPILOT_DB_NAME=archpilot
ARCHPILOT_DB_USER=archpilot
ARCHPILOT_DB_PASSWORD=
# Max upload size in bytes (default 1 MiB)
ARCHPILOT_MAX_UPLOAD_BYTES=1048576

# Database selection: postgres (default, required) | sqlite (local file) | auto (local dev only:
# try PostgreSQL once at startup, else use SQLite). PostgreSQL and SQLite data are separate.
ARCHPILOT_DATABASE_MODE=postgres
ARCHPILOT_SQLITE_PATH=data/archpilot.db
ARCHPILOT_DB_CONNECT_TIMEOUT_SECONDS=3

# LLM provider: fake (default, offline, deterministic) | kpmg_workbench
ARCHPILOT_LLM_PROVIDER=fake
# Workbench settings (only used when ARCHPILOT_LLM_PROVIDER=kpmg_workbench).
# Put the real key and charge code ONLY in your local, git-ignored .env, and only
# credentials approved for ArchPilotAI.
ARCHPILOT_WORKBENCH_AUTH_TYPE=subscription_key
ARCHPILOT_WORKBENCH_API_KEY=434a244fce044730acb979e9a92ce652
ARCHPILOT_WORKBENCH_ENDPOINT=https://api.workbench.kpmg
ARCHPILOT_WORKBENCH_DEPLOYMENT=gpt-4-1-2025-04-14-dzs-sdc
ARCHPILOT_WORKBENCH_API_VERSION=2024-10-21
ARCHPILOT_WORKBENCH_REGION=westeurope
ARCHPILOT_WORKBENCH_CHARGE_CODE=00000000
ARCHPILOT_WORKBENCH_APPROVAL_GROUP=
# Optional explicit corporate proxy, e.g. http://proxy.example:8080 (no embedded credentials)
ARCHPILOT_WORKBENCH_PROXY=http://deber-pxi-dc1.net.de.kworld.kpmg.com:4433
ARCHPILOT_WORKBENCH_TIMEOUT=90
ARCHPILOT_WORKBENCH_MAX_RETRIES=2
# Cost guards for /api/ai/generate
ARCHPILOT_AI_MAX_PROMPT_CHARS=4000
ARCHPILOT_AI_MAX_OUTPUT_TOKENS=400
ARCHPILOT_AI_MIN_INTERVAL_SECONDS=2.0
ARCHPILOT_EXTRACTION_ALLOW_REAL_PROVIDER=true

ARCHPILOT_EMBEDDING_PROVIDER=kpmg_workbench
ARCHPILOT_EMBEDDING_DEPLOYMENT=text-embedding-3-large-1-std-sdc
ARCHPILOT_EMBEDDING_DIMENSION=3072